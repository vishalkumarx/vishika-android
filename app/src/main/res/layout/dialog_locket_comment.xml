<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="#FFF0F5"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="💬"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/txtCommentDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Add a comment"
            android:textColor="#FF5C81"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="It will float over their photo 💕"
            android:textColor="#8A7A90"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_answer"
            android:padding="14dp">

            <EditText
                android:id="@+id/edtLocketCommentDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="Write something sweet..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="100"
                android:maxLines="4"
                android:minLines="3"
                android:textColor="#2D2036"
                android:textColorHint="#B0A0B5"
                android:textSize="16sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtCommentCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="0/100"
            android:textColor="#B0A0B5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSendLocketCommentDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF5C81"
            android:padding="12dp"
            android:text="Send"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnCancelLocketCommentDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Cancel"
                android:textColor="#8A7A90"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDeleteLocketCommentDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Delete"
                android:textColor="#E53935"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
