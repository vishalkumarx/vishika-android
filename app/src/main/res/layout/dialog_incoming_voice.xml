<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_button_answer"
    android:gravity="center">

    <!-- Animated mic icon container -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp">

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_dialog_icon" />

        <ImageView
            android:id="@+id/voiceNoteIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <TextView
        android:id="@+id/voiceNoteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voice Note 🎙️"
        android:textColor="#1A1A2E"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/voiceNoteSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Playing now..."
        android:textColor="#6B7280"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="24dp"/>

    <!-- Waveform animation bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <View android:id="@+id/bar1"
            android:layout_width="6dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"
            android:layout_gravity="center_vertical"/>
        <View android:id="@+id/bar2"
            android:layout_width="6dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
        <View android:id="@+id/bar3"
            android:layout_width="6dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
        <View android:id="@+id/bar4"
            android:layout_width="6dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
        <View android:id="@+id/bar5"
            android:layout_width="6dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
        <View android:id="@+id/bar6"
            android:layout_width="6dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
        <View android:id="@+id/bar7"
            android:layout_width="6dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="3dp"
            android:background="#FF4081"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/btnDismissVoice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Got it 💕"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#FF4081"
        app:cornerRadius="26dp"
        app:elevation="0dp"/>

</LinearLayout>
