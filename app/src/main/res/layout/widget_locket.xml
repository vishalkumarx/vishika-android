<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_pink"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widgetLocketTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Daily Locket 💛"
        android:textColor="#2D2036"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- My photo -->
        <ImageView
            android:id="@+id/widgetMyLocket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_heart"
            android:background="#FFE0EB" />

        <!-- Partner photo -->
        <ImageView
            android:id="@+id/widgetPartnerLocket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_heart"
            android:background="#FFE0EB" />

    </LinearLayout>

</LinearLayout>
