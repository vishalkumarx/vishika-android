<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4F9">

    <!-- Full-screen Google Map -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/liveTrackingMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBackLiveTrack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_distance_overlay"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#2D2036" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- LIVE Tracking Pill Badge -->
        <LinearLayout
            android:id="@+id/pillLiveHeader"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_distance_overlay"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/dotLivePulse"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_day" />

            <com.example.vishika.BoldTextView
                android:id="@+id/txtLiveHeaderBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE RADAR • 2s"
                android:textColor="#2D2036"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- History Shortcut Button -->
        <ImageView
            android:id="@+id/btnOpenHistoryFromLive"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_distance_overlay"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="#2D2036" />
    </LinearLayout>

    <!-- Floating Map Controls (Right Side above Bottom Card) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="260dp"
        android:orientation="vertical">

        <!-- Toggle Follow Partner Button -->
        <TextView
            android:id="@+id/btnFollowPartner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_distance_overlay"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🎯 Following"
            android:textColor="#FF4081"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Fit Both Users Button -->
        <TextView
            android:id="@+id/btnFitBoth"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_distance_overlay"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="💑 Show Both"
            android:textColor="#2D2036"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Swiggy/Zomato Style Bottom Live Status Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Row 1: Partner Avatar, Name + Movement Banner, Ping Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLivePartnerAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_photo_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.example.vishika.BoldTextView
                        android:id="@+id/txtLivePartnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Partner"
                        android:textColor="#2D2036"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Movement Activity Banner (Swiggy/Zomato style) -->
                    <TextView
                        android:id="@+id/txtLiveActivityBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📍 Stationary"
                        android:textColor="#FF4081"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Refresh / Ping Now Button -->
                <ImageView
                    android:id="@+id/btnPingPartnerNow"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_distance_overlay"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <!-- Row 2: Live Telemetry Badges (Distance, Speed, Battery, Accuracy) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Distance Chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#FDF2F7"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTANCE"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.example.vishika.BoldTextView
                        android:id="@+id/txtLiveChipDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="-- km"
                        android:textColor="#2D2036"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Battery Chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="#FDF2F7"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATTERY"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.example.vishika.BoldTextView
                        android:id="@+id/txtLiveChipBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🔋 --%"
                        android:textColor="#2D2036"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- GPS Accuracy Chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#FDF2F7"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCURACY"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.example.vishika.BoldTextView
                        android:id="@+id/txtLiveChipAccuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🎯 ±--m"
                        android:textColor="#2D2036"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Live Address & Second-by-Second Freshness Ticker -->
            <TextView
                android:id="@+id/txtLiveAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Fetching live street address..."
                android:textColor="#333333"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtLiveFreshness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Connecting to live GPS stream..."
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>

