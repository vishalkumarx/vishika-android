<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#FEDA75"
                android:centerColor="#D62976"
                android:endColor="#4F5BD5" />
        </shape>
    </item>
    <item
        android:top="2.5dp"
        android:bottom="2.5dp"
        android:left="2.5dp"
        android:right="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
